{
  "name": "darb-takehome",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "jest --coverage",
    "fixtures:render": "tsx scripts/fixtures/render-receipts.ts",
    "fixtures:payloads": "tsx scripts/fixtures/build-sample-payloads.ts",
    "fixtures:sanitize": "tsx scripts/fixtures/sanitize-photo.ts",
    "test:mix": "tsx scripts/quality/test-mix.ts",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:report": "tsx --env-file=.env scripts/demo/report.ts",
    "demo:webhooks": "bash scripts/demo/fire-webhooks.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "next-safe-action": "^8.7.3",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rotating-file-stream": "^3.2.10",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "pdf-lib": "1.17",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.6"
  }
}
