# SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Optional — defaults shown
# FIXTURES_DIR=fixtures            # mock extractor registry + WhatsApp media fixtures
# BLOB_DIR=.storage                # where received document bytes are stored (by content hash)
# MEDIA_FETCH_TIMEOUT_MS=3000      # WhatsApp media fetch timeout at intake
# LOG_SINK=pino                    # pino | console | test
# LOG_LEVEL=info
# LOG_FILE_ENABLED=true            # default: true outside production, false in production
# LOG_DIR=logs
# LOG_ROTATE_SIZE=10M
# LOG_ROTATE_INTERVAL=1d
# LOG_MAX_FILES=14

# Webhook authentication (bonus B5). Unset = that endpoint accepts unsigned requests (local dev; a warning is logged).
# WHATSAPP_APP_SECRET=...          # Meta app secret → verifies X-Hub-Signature-256 on POST /api/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN=...        # answers Meta's GET subscription handshake (hub.verify_token)
# EMAIL_WEBHOOK_SECRET=...         # verifies X-Signature-256 on POST /api/webhooks/email
# TRANSACTIONS_WEBHOOK_SECRET=...  # verifies X-Signature-256 on POST /api/transactions

# Real extraction (bonus B4). Default: the fixture-backed mock, no keys needed. Any OpenAI-compatible provider works:
# EXTRACTOR=llm
# LLM_BASE_URL=https://api.anthropic.com/v1/   # OpenAI https://api.openai.com/v1 · Gemini https://generativelanguage.googleapis.com/v1beta/openai/ · Ollama http://localhost:11434/v1
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=...                               # omit for keyless local servers
# LLM_TIMEOUT_MS=30000
# LLM_TEMPERATURE=                              # unset = provider default (Claude 4.7+ rejects values below 1)
# LLM_STRUCTURED_OUTPUT=false                   # true only where response_format json_schema is supported
