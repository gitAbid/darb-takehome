# SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Optional — defaults shown
# FIXTURES_DIR=fixtures            # mock extractor registry + WhatsApp media fixtures
# BLOB_DIR=.storage                # where received document bytes are stored (by content hash)
# MEDIA_FETCH_TIMEOUT_MS=3000      # WhatsApp media fetch timeout at intake
# LOG_SINK=pino                    # pino | console | test
# LOG_LEVEL=info
# LOG_FILE_ENABLED=true            # default: true outside production, false in production
# LOG_DIR=logs
# LOG_ROTATE_SIZE=10M
# LOG_ROTATE_INTERVAL=1d
# LOG_MAX_FILES=14
